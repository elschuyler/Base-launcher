<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/edit_item_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/activity_margin">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Clickable Icon Area -->
        <FrameLayout
            android:id="@+id/edit_item_icon_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/edit_item_icon"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:contentDescription="@string/change_icon"
                android:scaleType="fitCenter" />

            <ImageView
                android:id="@+id/edit_item_badge"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/circle_background"
                android:contentDescription="@string/change_icon"
                android:padding="5dp"
                android:src="@drawable/ic_rename_vector"
                app:tint="#FFFFFF" />

        </FrameLayout>

        <TextView
            android:id="@+id/edit_item_change_icon_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/tap_to_change_icon"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp" />

        <!-- Title / Label Input -->
        <org.fossify.commons.views.MyTextInputLayout
            android:id="@+id/edit_item_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/label">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_item_edittext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords"
                android:textSize="@dimen/bigger_text_size" />

        </org.fossify.commons.views.MyTextInputLayout>

    </LinearLayout>
</FrameLayout>
