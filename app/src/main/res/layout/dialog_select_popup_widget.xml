<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dialog_select_widget_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:padding="16dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/select_widget_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        app:cardBackgroundColor="#252D1F"
        app:cardCornerRadius="24dp"
        app:cardElevation="16dp"
        app:cardPreventCornerOverlap="false"
        app:strokeColor="#33FFFFFF"
        app:strokeWidth="0.8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header -->
            <RelativeLayout
                android:id="@+id/select_widget_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="18dp"
                android:paddingTop="14dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp">

                <ImageView
                    android:id="@+id/select_widget_icon"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_widget_vector" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="8dp"
                    android:layout_toStartOf="@id/select_widget_btn_close"
                    android:layout_toEndOf="@id/select_widget_icon"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/select_widget_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="@string/select_widget"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/select_widget_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="#C0D0B8"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/select_widget_btn_close"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/close"
                    android:padding="6dp"
                    android:src="@drawable/ic_cross_vector"
                    app:tint="#D5E0C8" />
            </RelativeLayout>

            <!-- Search and Filter Bar -->
            <LinearLayout
                android:id="@+id/select_widget_filter_holder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp">

                <EditText
                    android:id="@+id/select_widget_search_input"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/item_log_card_background"
                    android:drawableStart="@drawable/ic_search_vector"
                    android:drawablePadding="8dp"
                    android:hint="@string/search_widgets"
                    android:imeOptions="actionDone"
                    android:inputType="text"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#80FFFFFF"
                    android:textSize="14sp" />

                <!-- Filter Toggle Pill (e.g. "Showing Spotify widgets • Tap to show all") -->
                <TextView
                    android:id="@+id/select_widget_toggle_filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="4dp"
                    android:text="@string/show_all_widgets"
                    android:textColor="#A2E070"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.6dp"
                android:background="#25FFFFFF" />

            <!-- Empty State -->
            <TextView
                android:id="@+id/select_widget_empty_text"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:gravity="center"
                android:padding="16dp"
                android:text="@string/no_widgets_available"
                android:textColor="#80FFFFFF"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- Widgets List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/select_widget_recycler"
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingTop="4dp"
                android:paddingBottom="8dp"
                android:scrollbars="vertical" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
