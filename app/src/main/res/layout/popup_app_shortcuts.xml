<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/popup_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/popup_arrow_top"
        android:layout_width="16dp"
        android:layout_height="8dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_bubble_arrow_up"
        android:visibility="gone" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/popup_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="180dp"
        app:cardBackgroundColor="#252D1F"
        app:cardCornerRadius="18dp"
        app:cardElevation="8dp"
        app:cardPreventCornerOverlap="false"
        app:strokeColor="#33FFFFFF"
        app:strokeWidth="0.8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Top Header with App Name and Gear Icon -->
            <RelativeLayout
                android:id="@+id/popup_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="10dp"
                android:paddingBottom="6dp">

                <TextView
                    android:id="@+id/popup_app_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="6dp"
                    android:layout_toStartOf="@id/popup_app_info_btn"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/popup_app_info_btn"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/app_info"
                    android:padding="5dp"
                    android:src="@drawable/ic_settings_gear_vector"
                    app:tint="#D5E0C8" />
            </RelativeLayout>

            <View
                android:id="@+id/popup_header_divider"
                android:layout_width="match_parent"
                android:layout_height="0.6dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:background="#25FFFFFF" />

            <!-- Shortcuts Container -->
            <LinearLayout
                android:id="@+id/popup_shortcuts_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />

            <!-- Horizontal Action Pill Bar -->
            <LinearLayout
                android:id="@+id/popup_actions_bar"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:id="@+id/popup_action_unarchive_btn"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginHorizontal="2dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/unarchive_app"
                    android:padding="6dp"
                    android:src="@drawable/ic_cloud_download_vector"
                    android:visibility="gone"
                    app:tint="#A0DF88" />

                <ImageView
                    android:id="@+id/popup_action_remove_btn"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginHorizontal="2dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/remove"
                    android:padding="6dp"
                    android:src="@drawable/ic_cross_vector"
                    app:tint="#D5E0C8" />

                <ImageView
                    android:id="@+id/popup_action_rename_btn"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginHorizontal="2dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/custom_icon"
                    android:padding="6dp"
                    android:src="@drawable/ic_rename_vector"
                    app:tint="#D5E0C8" />

                <ImageView
                    android:id="@+id/popup_action_gestures_btn"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginHorizontal="2dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/gestures"
                    android:padding="6dp"
                    android:src="@drawable/ic_touch_vector"
                    app:tint="#D5E0C8" />

                <ImageView
                    android:id="@+id/popup_action_hide_btn"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginHorizontal="2dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/hide_icon"
                    android:padding="6dp"
                    android:src="@drawable/ic_hide_vector"
                    app:tint="#D5E0C8" />

                <ImageView
                    android:id="@+id/popup_action_lock_btn"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginHorizontal="2dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/lock_app"
                    android:padding="6dp"
                    android:src="@drawable/ic_lock_vector"
                    app:tint="#D5E0C8" />

                <ImageView
                    android:id="@+id/popup_action_uninstall_btn"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginHorizontal="2dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/uninstall"
                    android:padding="6dp"
                    android:src="@drawable/ic_delete_vector"
                    app:tint="#F08888" />

                <ImageView
                    android:id="@+id/popup_action_resize_btn"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginHorizontal="2dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/resize"
                    android:padding="6dp"
                    android:src="@drawable/ic_resize_vector"
                    app:tint="#D5E0C8" />

            </LinearLayout>

            <!-- Set as Default Launcher Prompt (shown when launcher has no shortcut host permission) -->
            <LinearLayout
                android:id="@+id/popup_default_launcher_prompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#20FFFFFF"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/set_as_default_to_enable_shortcuts"
                    android:textColor="#C0D0B8"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/popup_btn_set_default"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:text="@string/set_default"
                    android:textColor="#A0DF88"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <ImageView
        android:id="@+id/popup_arrow_bottom"
        android:layout_width="16dp"
        android:layout_height="8dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_bubble_arrow_down"
        android:visibility="gone" />

</LinearLayout>
