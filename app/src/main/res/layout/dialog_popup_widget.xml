<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dialog_popup_widget_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:padding="16dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/popup_widget_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        app:cardBackgroundColor="#252D1F"
        app:cardCornerRadius="24dp"
        app:cardElevation="16dp"
        app:cardPreventCornerOverlap="false"
        app:strokeColor="#33FFFFFF"
        app:strokeWidth="0.8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header Bar -->
            <RelativeLayout
                android:id="@+id/popup_widget_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="10dp">

                <ImageView
                    android:id="@+id/popup_widget_app_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_widget_vector" />

                <TextView
                    android:id="@+id/popup_widget_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="8dp"
                    android:layout_toStartOf="@id/popup_widget_actions_container"
                    android:layout_toEndOf="@id/popup_widget_app_icon"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/popup_widget_actions_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Reconfigure Button (shown if widget has configure activity) -->
                    <ImageView
                        android:id="@+id/popup_widget_btn_configure"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/reconfigure_widget"
                        android:padding="6dp"
                        android:src="@drawable/ic_settings_gear_vector"
                        android:visibility="gone"
                        app:tint="#D5E0C8" />

                    <!-- Change / Unlink Widget Button -->
                    <ImageView
                        android:id="@+id/popup_widget_btn_unlink"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_marginStart="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/change_widget"
                        android:padding="6dp"
                        android:src="@drawable/ic_unlink_vector"
                        app:tint="#D5E0C8" />

                    <!-- Close Button -->
                    <ImageView
                        android:id="@+id/popup_widget_btn_close"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_marginStart="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/close"
                        android:padding="6dp"
                        android:src="@drawable/ic_cross_vector"
                        app:tint="#D5E0C8" />
                </LinearLayout>
            </RelativeLayout>

            <View
                android:id="@+id/popup_widget_divider"
                android:layout_width="match_parent"
                android:layout_height="0.6dp"
                android:background="#25FFFFFF" />

            <!-- Frame hosting the MyAppWidgetHostView -->
            <FrameLayout
                android:id="@+id/popup_widget_content_frame"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:clipChildren="true"
                android:clipToPadding="true"
                android:minHeight="140dp"
                android:padding="8dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
