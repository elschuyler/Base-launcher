<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="AppTheme.Base" />

    <style name="LauncherTheme" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.App.PopupMenu.WhiteSky" parent="ThemeOverlay.Material3.Light">
        <item name="android:colorBackground">#FFFFFF</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="android:textColorPrimary">#0F172A</item>
        <item name="android:textColorSecondary">#475569</item>
        <item name="android:textColor">#0F172A</item>
        <item name="colorControlNormal">#38BDF8</item>
        <item name="colorControlHighlight">#E0F2FE</item>
        <item name="android:popupBackground">@drawable/menu_popup_background_white_sky</item>
        <item name="popupMenuBackground">@drawable/menu_popup_background_white_sky</item>
        <item name="android:itemBackground">@drawable/menu_item_selector_sky</item>
        <item name="android:popupMenuStyle">@style/Widget.App.PopupMenu.WhiteSky</item>
        <item name="popupMenuStyle">@style/Widget.App.PopupMenu.WhiteSky</item>
        <item name="android:itemTextAppearance">@style/TextAppearance.App.PopupMenu.Large</item>
        <item name="itemTextAppearance">@style/TextAppearance.App.PopupMenu.Large</item>
    </style>

    <style name="Widget.App.PopupMenu.WhiteSky" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@drawable/menu_popup_background_white_sky</item>
        <item name="popupMenuBackground">@drawable/menu_popup_background_white_sky</item>
    </style>

    <style name="TextAppearance.App.PopupMenu.Large" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">#0F172A</item>
    </style>
</resources>
